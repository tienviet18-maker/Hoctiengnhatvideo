{
  "name": "vimai-video",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/gen-catalog.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/gen-catalog.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "pretypecheck": "node scripts/gen-catalog.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "qc": "node scripts/qc-content.mjs && node scripts/qc-standard.mjs && node scripts/lesson-furigana.mjs --check",
    "verify": "npm run qc && npm run typecheck && npm run lint && npm run build",
    "qc:report": "node scripts/qc-standard.mjs --report"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "kuromoji": "0.1.2",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  }
}
