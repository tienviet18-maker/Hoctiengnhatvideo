rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Tài khoản thật (Google, Apple, email), không phải ẩn danh.
    function isAccountOwner(userId) {
      return request.auth != null && request.auth.uid == userId
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
    function validProgress() {
      let d = request.resource.data;
      return d.keys().hasOnly(['v', 'data', 'updatedAt'])
        && d.keys().hasAll(['v', 'data', 'updatedAt'])
        && d.v is int && d.data is string && d.data.size() <= 900000
        && d.updatedAt == request.time;
    }
    // Tiến độ học (src/lib/cloud-sync.ts): chỉ chính chủ đọc và ghi.
    match /users/{userId}/progress/{docId} {
      allow read, delete: if isAccountOwner(userId) && docId == 'main';
      allow create, update: if isAccountOwner(userId) && docId == 'main' && validProgress();
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
